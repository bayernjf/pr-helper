{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist"
  ,"functions": { "api/**/*.ts": { "maxDuration": 60 } }
  ,"rewrites": [
    { "source": "/api/ai-credentials", "destination": "/api/workflows?resource=ai-credentials" },
    { "source": "/api/automation", "destination": "/api/workflows?resource=automation" }
  ]
}
